{
  "name": "weave-openchamber",
  "version": "0.2.0",
  "description": "weave for OpenChamber: the open project's map in a panel (search it in plain words, see what a file is and what a change to it reaches, add it to the chat) and weave's contract gate in Work Status.",
  "license": "MIT",
  "type": "module",
  "repository": "https://github.com/michalbasisty/weave",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.6.0"
    },
    "id": "weave",
    "name": "weave",
    "icon": "icon.svg",
    "contributes": {
      "panel": {
        "id": "weave",
        "name": "weave",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "title": "weave gate",
        "source": {
          "path": "/status",
          "interval": 5000
        },
        "requiresProject": true
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "weave",
            "git"
          ]
        }
      }
    }
  }
}
