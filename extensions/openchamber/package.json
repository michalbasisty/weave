{
  "name": "weave-openchamber",
  "version": "0.4.0",
  "description": "weave for OpenChamber, with nothing to install: it fetches weave itself. A panel with the open project's map (screens, endpoints, modules, tables, search in plain words, what a change reaches), your uncommitted change checked by weave's contract gate, the project's specs (change records with their tasks, to tick, edit and hand to a new agent session), @weave in the composer, and the gate run after every agent turn.",
  "license": "MIT",
  "type": "module",
  "repository": "https://github.com/michalbasisty/weave",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "id": "weave",
    "name": "weave",
    "icon": "icon.svg",
    "contributes": {
      "panel": {
        "id": "weave",
        "name": "weave",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "title": "weave gate",
        "source": {
          "path": "/status",
          "interval": 5000
        },
        "requiresProject": true
      },
      "actions": [
        {
          "id": "impact",
          "label": "weave: what a change reaches",
          "icon": "icon.svg",
          "where": "file"
        }
      ],
      "mentions": {
        "label": "weave map"
      },
      "instructions": true,
      "sessionEvents": {
        "events": [
          "turn-started",
          "turn-finished"
        ]
      },
      "sessionControl": {},
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "weave",
            "git"
          ]
        },
        "keepRunning": true
      }
    }
  }
}
